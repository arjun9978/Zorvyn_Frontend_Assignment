# FinEnsure Demo - Environment Variables
# Copy this file to .env and update values as needed

# ===========================================
# REQUIRED FOR DEMO
# ===========================================

# Mock Mode - Set to true to use localStorage instead of real backend
VITE_MOCK_MODE=true

# Redux persist key (can be any string)
VITE_REDUX_PERSIST_SECRET_KEY=redux-persist

# ===========================================
# OPTIONAL - AI RECEIPT SCANNING
# ===========================================

# Backend API URL - Only needed if you want AI receipt scanning
# Deploy the backend to Render and add the URL here
VITE_API_BASE_URL=https://your-backend-url.onrender.com/api

# ===========================================
# NOT USED IN DEMO MODE
# ===========================================

# Firebase Configuration - Not required for demo
# Only needed if VITE_MOCK_MODE=false
# VITE_FIREBASE_API_KEY=your-firebase-api-key
# VITE_FIREBASE_AUTH_DOMAIN=your-firebase-auth-domain
# VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
# VITE_FIREBASE_STORAGE_BUCKET=your-firebase-storage-bucket
# VITE_FIREBASE_MESSAGING_SENDER_ID=your-firebase-sender-id
# VITE_FIREBASE_APP_ID=your-firebase-app-id
# VITE_FIREBASE_MEASUREMENT_ID=your-firebase-measurement-id
