# Production Environment Variables for FinEnsure Demo
# These values should be set in Vercel environment variables

# Mock Mode - Must be true for frontend-only demo
VITE_MOCK_MODE=true

# Backend API URL - Only needed for AI receipt scanning
# Update this with your Render backend URL if using AI features
VITE_API_BASE_URL=https://your-backend-url.onrender.com/api

# Redux persist key
VITE_REDUX_PERSIST_SECRET_KEY=redux-persist
